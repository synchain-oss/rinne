{
  "about": "本地 gates 的定档规则，由 scripts/lib/Tiers.psm1 读取（gates.ps1 与合并时的 pr-merge 共用）。git diff <Base>...HEAD 里每个文件：命中 quick 白名单的是 Quick，其余至少是 default；rules 只往上抬，取命中规则的最高档；整个 diff 取各文件的最高档，卡片规定的档只能再往上抬。正则一律不区分大小写，对仓内相对路径（正斜杠）匹配。ignoredInputs：被 .gitignore 忽略、构建却会读的文件，存在即算工作区不干净。gates：各档必须有的 gate；档里的条目没有 gates.d 模块注册时，requires 列的路径在工作树或基线上存在就判 FAIL，都不存在才记 SKIP 并写明原因。cases：gates.ps1 -SelfTest 的表驱动用例；want 是最低档，ask 是本次选的档，fail 表示所选档低于最低档、必须判 FAIL。",
  "tiers": ["Quick", "Standard", "Full"],
  "default": "Standard",
  "quick": [
    "^docs/",
    "^(?!(?:src|tests|tools|cmake|third_party|web|web-preview|packaging)/).*\\.md$",
    "^\\.github/(?:ISSUE_TEMPLATE/|pull_request_template\\.md$|CODEOWNERS$|labels\\.json$)",
    "^scripts/(?:hooks|maintainer|checks\\.d|lib)/",
    "^scripts/[^/]+\\.mjs$",
    "^scripts/(?:gates\\.ps1|bootstrap-tools\\.ps1|gates\\.d/1\\d-[^/]+\\.ps1)$",
    "^\\.(?:gitignore|prettierignore|prettierrc\\.json|editorconfig|gitleaks\\.toml|clang-format)$",
    "^\\.(?:gitleaks|prettier|actionlint|node|clang-format)-version$",
    "^(?:REUSE\\.toml|requirements-tools\\.txt)$",
    "^upstream/[^/]+\\.json$"
  ],
  "rules": [
    {
      "tier": "Standard",
      "re": "^(?:src|tests|cmake|tools|third_party)/",
      "why": "C++ 源码、测试、CMake 模块、工具与第三方源码"
    },
    {
      "tier": "Standard",
      "re": "(?:^|/)CMake(?:Lists\\.txt|Presets\\.json)$|\\.cmake$",
      "why": "任何 CMake 文件与预设"
    },
    {
      "tier": "Standard",
      "re": "^\\.(?:juce-version|juce-commit|pluginval-version|sccache-version|sccache-sha256)$",
      "why": "构建用的钉版"
    },
    {
      "tier": "Standard",
      "re": "^scripts/(?:build\\.ps1$|ci/|gates\\.d/[23]\\d-)",
      "why": "构建脚本、CI 调用的脚本、构建与 pluginval 的 gate 模块"
    },
    { "tier": "Full", "re": "^(?:web|web-preview|packaging)/", "why": "前端、页面预览与打包" },
    { "tier": "Full", "re": "^src/plugin-common/", "why": "两个插件共用的壳与编辑器底座" },
    { "tier": "Full", "re": "^src/.*editor[^/]*$", "why": "编辑器" },
    {
      "tier": "Full",
      "re": "^scripts/(?:gates\\.d/[4-9]\\d-|package|stress)",
      "why": "压测、页面冒烟、打包的 gate 模块与脚本"
    }
  ],
  "ignoredInputs": ["CMakeUserPresets.json"],
  "gates": [
    { "id": "G1", "tier": "Quick", "what": "预检：工作区干净、gh 账号、仓内身份、remote、hooks、工具版本" },
    { "id": "G1-juce", "tier": "Quick", "what": "JUCE 的 HEAD 与 .juce-commit 一致" },
    { "id": "G2-cxx", "tier": "Quick", "what": "clang-format" },
    { "id": "G2-prettier", "tier": "Quick", "what": "prettier" },
    { "id": "G3", "tier": "Quick", "what": "compliance：gitleaks、reuse、SPDX、闭包、离线、隐私" },
    { "id": "G4", "tier": "Quick", "what": "commits：提交卫生、分支名、冻结契约守卫" },
    { "id": "G5", "tier": "Quick", "what": "docs-truth（run-checks 的 docs 组，web 单测也注册在这一组）" },
    {
      "id": "G6",
      "tier": "Standard",
      "what": "构建（Ninja，零 warning）",
      "by": "gates.d/20-*.ps1",
      "requires": ["CMakeLists.txt"]
    },
    {
      "id": "G7",
      "tier": "Standard",
      "what": "ctest（含 IPC 命名空间生效自检）",
      "by": "gates.d/20-*.ps1",
      "requires": ["CMakeLists.txt"]
    },
    {
      "id": "G8",
      "tier": "Standard",
      "what": "pluginval（无 GUI）",
      "by": "gates.d/30-*.ps1",
      "requires": ["CMakeLists.txt"]
    },
    {
      "id": "G8-gui",
      "tier": "Full",
      "what": "pluginval（GUI）",
      "by": "gates.d/30-*.ps1",
      "requires": ["CMakeLists.txt"]
    },
    {
      "id": "stress",
      "tier": "Full",
      "what": "压测",
      "by": "gates.d/40-stress.ps1",
      "requires": ["scripts/gates.d/40-stress.ps1"]
    },
    {
      "id": "mutation",
      "tier": "Full",
      "what": "全仓变异检查（run-checks --mutation-check）与 mutationCheck 覆盖清单核对",
      "by": "gates.d/45-*.ps1",
      "requires": ["scripts/gates.d/45-mutation.ps1"]
    },
    { "id": "G9-web", "tier": "Full", "what": "页面冒烟", "by": "gates.d/50-*.ps1", "requires": ["web-preview"] },
    { "id": "G9-pkg", "tier": "Full", "what": "打包", "by": "gates.d/60-*.ps1", "requires": ["packaging"] }
  ],
  "cases": [
    { "files": [], "want": "Quick" },
    { "files": ["README.md", "CHANGELOG.md", "CLAUDE.md", "docs/adr/0001-two-binaries.md"], "want": "Quick" },
    { "files": ["docs/src/notes.md", "Docs/Notes.MD", "docs/design/box.png"], "want": "Quick" },
    {
      "files": [
        "scripts/gates.ps1",
        "scripts/gates.d/10-static.ps1",
        "scripts/lib/Locks.psm1",
        "scripts/lib/tier-rules.json",
        "scripts/bootstrap-tools.ps1"
      ],
      "want": "Quick"
    },
    {
      "files": [
        "scripts/run-checks.mjs",
        "scripts/checks.d/path-case.mjs",
        "scripts/hooks/pre-push",
        "scripts/maintainer/pr-merge.ps1"
      ],
      "want": "Quick"
    },
    {
      "files": [
        ".github/pull_request_template.md",
        ".github/ISSUE_TEMPLATE/bug.yml",
        ".github/CODEOWNERS",
        ".github/labels.json"
      ],
      "want": "Quick"
    },
    {
      "files": [
        ".gitleaks-version",
        ".prettierrc.json",
        ".gitignore",
        ".clang-format",
        "REUSE.toml",
        "requirements-tools.txt",
        "upstream/gates.json"
      ],
      "want": "Quick"
    },
    { "files": [".github/workflows/build.yml"], "want": "Standard" },
    { "files": [".gitattributes"], "want": "Standard" },
    { "files": ["LICENSE"], "want": "Standard" },
    { "files": ["CMakePresets.json"], "want": "Standard" },
    { "files": ["scripts/build.ps1"], "want": "Standard" },
    { "files": ["scripts/ci/mac/build.sh"], "want": "Standard" },
    { "files": ["scripts/check-ctest-timeouts.ps1", "scripts/fetch_fonts.py"], "want": "Standard" },
    { "files": ["third_party/foo/x.c"], "want": "Standard" },
    { "files": ["third_party/notices/juce.LICENSE.md"], "want": "Standard" },
    { "files": [".juce-version"], "want": "Standard" },
    { "files": [".juce-commit"], "want": "Standard" },
    { "files": ["src/core/ipc/Naming.cpp"], "want": "Standard" },
    { "files": ["src/core/README.md"], "want": "Standard" },
    { "files": ["tests/core/test_naming.cpp"], "want": "Standard" },
    { "files": ["TESTS/core/test_b.cpp"], "want": "Standard" },
    { "files": ["Src/core/evil.cpp"], "want": "Standard" },
    { "files": ["srcx/a.cpp"], "want": "Standard" },
    { "files": ["cmake/RinneMac.cmake"], "want": "Standard" },
    { "files": ["docs/CMakeLists.txt"], "want": "Standard" },
    { "files": ["tools/rinne_nulltest.cpp"], "want": "Standard" },
    { "files": ["scripts/gates.d/20-build.ps1"], "want": "Standard" },
    {
      "files": ["src/input/InputProcessor.cpp", "src/output/OutputPluginEntry.cpp", "src/core/mac/Seg.mm"],
      "want": "Standard"
    },
    { "files": ["web/shared/tokens.css"], "want": "Full" },
    { "files": ["WEB/shared/x.js"], "want": "Full" },
    { "files": ["web-preview/serve.mjs"], "want": "Full" },
    { "files": ["src/plugin-common/RinneProcessorBase.cpp"], "want": "Full" },
    { "files": ["SRC/Plugin-Common/x.cpp"], "want": "Full" },
    { "files": ["src/input/InputEditor.cpp"], "want": "Full" },
    { "files": ["src/output/outputeditor.h"], "want": "Full" },
    { "files": ["packaging/INSTALL.txt"], "want": "Full" },
    { "files": ["scripts/gates.d/40-stress.ps1"], "want": "Full" },
    { "files": ["scripts/gates.d/45-mutation.ps1"], "want": "Full" },
    { "files": ["scripts/package.ps1"], "want": "Full" },
    { "files": ["scripts/stress.ps1"], "want": "Full" },
    { "files": ["docs/a.md", "web/input/app.js"], "want": "Full" },
    { "files": ["docs/a.md"], "card": "Standard", "want": "Standard" },
    { "files": ["src/core/a.cpp"], "card": "Full", "want": "Full" },
    { "files": ["web/x.js"], "card": "Quick", "want": "Full" },
    { "files": ["src/core/a.cpp"], "ask": "Standard", "want": "Standard" },
    { "files": ["src/core/a.cpp"], "ask": "Full", "want": "Standard" },
    { "files": ["src/core/a.cpp"], "ask": "Quick", "want": "Standard", "fail": true },
    { "files": ["TESTS/core/x.cpp"], "ask": "Quick", "want": "Standard", "fail": true },
    { "files": ["scripts/build.ps1"], "ask": "Quick", "want": "Standard", "fail": true },
    { "files": ["web/x.js"], "ask": "Standard", "want": "Full", "fail": true },
    { "files": ["README.md"], "card": "Standard", "ask": "Quick", "want": "Standard", "fail": true },
    { "files": ["README.md"], "card": "Full", "ask": "Standard", "want": "Full", "fail": true }
  ]
}
