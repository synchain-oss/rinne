{
  "schema": 1,
  "notes": "第一段：Input 在首、Output 在末的空壳直通。第二段（探针构建）的场景在 probe 一节。以后加场景只往 scenarios 里加条目：新种类在 Scenarios.psm1 的登记表里加一项，环境变量放进条目的 env。反例除 expect（结局）外还要写 expectDetail（结局里必须出现的原因，正则）：没启动、没执行凑出来的同名结局不算验证过。",
  "signal": { "kind": "impulse-noise", "seconds": 4 },
  "limits": {
    "renderTimeoutSec": 90,
    "luaTimeoutSec": 120,
    "instances": { "cycles": 25, "warmup": 5, "play": false, "maxHandleGrowth": 150, "maxPrivateGrowthMB": 150 }
  },
  "scenarios": [
    { "id": "null-offline-44100-64", "kind": "render", "mode": "offline", "sr": 44100, "block": 64 },
    { "id": "null-offline-44100-512", "kind": "render", "mode": "offline", "sr": 44100, "block": 512 },
    { "id": "null-offline-44100-1024", "kind": "render", "mode": "offline", "sr": 44100, "block": 1024 },
    { "id": "null-offline-48000-64", "kind": "render", "mode": "offline", "sr": 48000, "block": 64 },
    { "id": "null-offline-48000-512", "kind": "render", "mode": "offline", "sr": 48000, "block": 512 },
    { "id": "null-offline-48000-1024", "kind": "render", "mode": "offline", "sr": 48000, "block": 1024 },
    { "id": "null-1x-44100-64", "kind": "render", "mode": "1x", "sr": 44100, "block": 64 },
    { "id": "null-1x-44100-512", "kind": "render", "mode": "1x", "sr": 44100, "block": 512 },
    { "id": "null-1x-44100-1024", "kind": "render", "mode": "1x", "sr": 44100, "block": 1024 },
    { "id": "null-1x-48000-64", "kind": "render", "mode": "1x", "sr": 48000, "block": 64 },
    { "id": "null-1x-48000-512", "kind": "render", "mode": "1x", "sr": 48000, "block": 512 },
    { "id": "null-1x-48000-1024", "kind": "render", "mode": "1x", "sr": 48000, "block": 1024 },
    { "id": "device-44100-64", "kind": "probe", "sr": 44100, "block": 64 },
    { "id": "device-44100-512", "kind": "probe", "sr": 44100, "block": 512 },
    { "id": "device-44100-1024", "kind": "probe", "sr": 44100, "block": 1024 },
    { "id": "device-48000-64", "kind": "probe", "sr": 48000, "block": 64 },
    { "id": "device-48000-512", "kind": "probe", "sr": 48000, "block": 512 },
    { "id": "device-48000-1024", "kind": "probe", "sr": 48000, "block": 1024 },
    { "id": "mono-offline", "kind": "render", "mode": "offline", "sr": 48000, "block": 512, "mono": true },
    { "id": "bypass-input", "kind": "render", "mode": "offline", "sr": 48000, "block": 512, "bypass": ["input"] },
    { "id": "bypass-output", "kind": "render", "mode": "offline", "sr": 48000, "block": 512, "bypass": ["output"] },
    {
      "id": "bypass-both",
      "kind": "render",
      "mode": "offline",
      "sr": 48000,
      "block": 512,
      "bypass": ["input", "output"]
    },
    { "id": "save-reopen", "kind": "savereopen", "bypass": ["output"] },
    { "id": "instances-25", "kind": "instances" }
  ],
  "negative": [
    {
      "id": "neg-offset-1-sample",
      "kind": "render",
      "mode": "offline",
      "sr": 48000,
      "block": 512,
      "mutate": { "sourceOffsetSamples": 1 },
      "expect": "FAIL",
      "expectDetail": "^逐位相同=否 lag=1 "
    },
    {
      "id": "neg-track-minus-6db",
      "kind": "render",
      "mode": "offline",
      "sr": 48000,
      "block": 512,
      "mutate": { "trackVolume": 0.5 },
      "expect": "FAIL",
      "expectDetail": "^逐位相同=否 lag=0 前2s峰值=-6\\."
    },
    { "id": "neg-timeout", "kind": "hang", "timeoutSec": 8, "expect": "INCOMPLETE", "expectDetail": "^超时（" },
    { "id": "neg-killed", "kind": "hang", "killAfterSec": 4, "expect": "INCOMPLETE", "expectDetail": "^到点被结束（" },
    {
      "id": "neg-user-testing",
      "kind": "guard",
      "guard": "user-testing",
      "expect": "SKIPPED",
      "expectDetail": "launches=0；USER_TESTING 标记存在"
    },
    {
      "id": "neg-sentinel-missing",
      "kind": "guard",
      "guard": "sentinel-missing",
      "expect": "REFUSED",
      "expectDetail": "^REFUSED: .*哨兵"
    },
    {
      "id": "neg-default-dir",
      "kind": "guard",
      "guard": "default-dir",
      "expect": "REFUSED",
      "expectDetail": "^REFUSED: .*永不碰"
    }
  ],
  "probe": {
    "notes": "第二段（run.ps1 -Probe，探针构建）：一条轨道 [Probe In][Probe Out]，Dummy 设备，feedback 保持探针默认的 0。记录窗口只靠三个隐藏参数开（auto_case / auto_variant / auto_record_s），探针自动开的窗口里 buf 写 -、guard 写 na。group 是两端探针 state 里的组（0..7 即 A..H），两端同组才会配对。每次 REAPER 正常退出后把它自己的日志从文档目录下的 Rinne Probe Logs 搬进本轮的结果目录。",
    "signal": { "kind": "impulse-noise", "seconds": 10 },
    "group": 0,
    "limits": { "renderTimeoutSec": 90, "luaTimeoutSec": 120, "leadSeconds": 1.5, "marginSeconds": 2, "minBlocks": 32 },
    "scenarios": [
      {
        "id": "probe-steady-48000-64",
        "kind": "probe-play",
        "sr": 48000,
        "block": 64,
        "case": "CB-01",
        "variant": "steady",
        "recordSeconds": 14,
        "playSeconds": 8,
        "analyzerMustPass": ["A1", "A4", "A8"]
      },
      {
        "id": "probe-steady-48000-512",
        "kind": "probe-play",
        "sr": 48000,
        "block": 512,
        "case": "CB-01",
        "variant": "steady",
        "recordSeconds": 14,
        "playSeconds": 8,
        "analyzerMustPass": ["A1", "A4", "A8"]
      },
      {
        "id": "probe-steady-48000-1024",
        "kind": "probe-play",
        "sr": 48000,
        "block": 1024,
        "case": "CB-01",
        "variant": "steady",
        "recordSeconds": 14,
        "playSeconds": 8,
        "analyzerMustPass": ["A1", "A4", "A8"]
      },
      {
        "id": "probe-export-48000-512",
        "kind": "probe-export",
        "sr": 48000,
        "block": 512,
        "case": "CB-04",
        "recordSeconds": 16,
        "analyzerMustPass": ["A3", "A8"]
      },
      {
        "id": "probe-steady-44100-512",
        "kind": "probe-play",
        "sr": 44100,
        "block": 512,
        "case": "CB-01",
        "variant": "steady",
        "recordSeconds": 14,
        "playSeconds": 8,
        "analyzerMustPass": ["A1", "A4", "A8"]
      }
    ],
    "negative": [
      {
        "id": "neg-probe-unpaired",
        "kind": "probe-play",
        "sr": 48000,
        "block": 512,
        "case": "CB-01",
        "variant": "steady",
        "recordSeconds": 14,
        "playSeconds": 8,
        "analyzerMustPass": ["A1", "A4", "A8"],
        "group": -1,
        "expect": "FAIL",
        "expectDetail": "没有配对"
      }
    ]
  }
}
